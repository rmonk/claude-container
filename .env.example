# Compose project environment (copy to .env): used for ${...} substitution in compose.yaml
# and loaded into the proxy only, never the claude container.

# The URL you open the terminal at, e.g. https://claude.<your-tailnet>.ts.net. Required.
# Passkeys are bound to its hostname: changing it means registering them again.
GATE_ORIGIN=

# GitHub token the proxy injects for github.com, api.github.com, uploads.github.com and
# raw.githubusercontent.com. Leave empty to inject nothing.
GITHUB_TOKEN=
