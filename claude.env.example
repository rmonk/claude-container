# Environment for the claude container only (copy to claude.env).
# Nothing is required; login is handled by the gate (see gate.env.example).

# Git identity for commits made in the container. Applied to ~/.gitconfig on every
# start when set (so changing it here and redeploying updates it); leave empty to
# manage it with `git config --global` yourself. With commit signing on, use an
# address on your GitHub account so the commits show as Verified.
GIT_USER_NAME=
GIT_USER_EMAIL=
