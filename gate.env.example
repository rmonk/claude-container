# Environment for the gate (passkey login) only (copy to gate.env).
# Lets a passkey be registered at /auth/register without being signed in. Set it for the
# first passkey (or to recover), e.g. to the output of `openssl rand -hex 16`; then
# clear it and redeploy.
GATE_SETUP_CODE=
# How long a sign-in lasts, in days (default 30).
#GATE_SESSION_DAYS=30
