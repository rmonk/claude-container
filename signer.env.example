# Environment for the signer container only (copy to signer.env).
# Claude's commit-signing key: an SSH private key, base64-encoded on one line. Generate it with
#   ssh-keygen -t ed25519 -N '' -C claude-signing -f claude-signing
#   base64 -w0 claude-signing
# then add claude-signing.pub on GitHub as a *signing* key (not an authentication key).
# Leave empty to turn commit signing off.
SIGNING_KEY_B64=
